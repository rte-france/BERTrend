FROM python:3.13-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && \
    apt-get install -y \
    less \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv globally to /usr/local/bin
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Use ARG to allow build-time variables
ARG HOST_UID=1000
ARG HOST_GID=1000

# Create cache directories and ensure they are writable by any user
RUN mkdir -p /app/.cache/huggingface /app/.cache/uv && \
    chmod -R 777 /app/.cache

# Copy the entire bertrend package into the container
COPY /bertrend/services/embedding_server/ /bertrend/services/embedding_server/
COPY bertrend/services/key.pem /bertrend/services/
COPY bertrend/services/cert.pem /bertrend/services/

# Add the root directory to the Python path
ENV PYTHONPATH=/


# Set workdir
WORKDIR /bertrend/services/embedding_server/

# Install minimum requirements as host user
RUN uv pip install --no-cache-dir --system -r requirements.txt

# Give the container user a name. It runs as an arbitrary numeric HOST_UID with
# no /etc/passwd entry, so getpass.getuser() raises "OSError: No username set in
# the environment". torch calls it at import time to name its inductor cache dir,
# and this image installs sentence_transformers, which pulls torch in.
# The value only builds cache paths; it does not change the runtime uid.
ENV USER=bertrend \
    LOGNAME=bertrend

# Expose the embedding server port
EXPOSE 6464

# Run with the system interpreter the requirements were installed into above.
# (start.py resolves ../key.pem and ../cert.pem relative to the WORKDIR set above.)
CMD ["python", "/bertrend/services/embedding_server/start.py"]