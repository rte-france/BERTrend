# BERTrend environment configuration
# Copy this file as needed and fill in the secrets/values for your environment.
# Do NOT commit real secrets to version control.
#-------------------------
# Docker run args
#-------------------------
HOST_UID=
HOST_GID=

# ------------------------
# Misc
# ------------------------
# CUDA devices selection for scheduled jobs, e.g., "0", "0,1" or empty for CPU
CUDA_VISIBLE_DEVICES=0

# ------------------------
# OpenAI / LLM configuration
# ------------------------
# Standard OpenAI-compatible settings (used by demos and LLM utils)
OPENAI_API_KEY=
# If using Azure OpenAI or other compatible endpoints (such as LiteLLM)
OPENAI_BASE_URL=
# Default model used across demos/agents (e.g., gpt-5.6-luna, gpt-5, mistral-medium, etc.)
OPENAI_DEFAULT_MODEL=

# GPT-5 reasoning effort (one of: minimal, low, medium, high). Only applies to
# GPT-5-family models; ignored otherwise. Invalid values fall back to the default.
# Global default used by every LLM task:
OPENAI_REASONING_EFFORT=low
# Optional per-task overrides (leave empty to inherit OPENAI_REASONING_EFFORT):
# - topic description (lightweight; "low" is usually enough)
OPENAI_REASONING_EFFORT_TOPIC_DESCRIPTION=
# - weak/strong signal analysis (heavier; consider "medium"/"high" for deeper reasoning)
OPENAI_REASONING_EFFORT_SIGNAL_ANALYSIS=

# ------------------------
# BERTrend base/config paths
# ------------------------
# Optional: override base directory for BERTrend data/models/logs
BERTREND_BASE_DIR=
BERTREND_CONTACT_EMAIL=bertrend@contact.com

#--------------------------
# Services used by BERTrend
#--------------------------
# Optional: embedding service URL
EMBEDDING_SERVICE_URL=
# Required when using the embedding service. Generate a unique value with:
# openssl rand -hex 32
BERTREND_CLIENT_SECRET=

#--------------------------
# Services used by BERTrend APPS
#--------------------------
# Optional: BERTrend APPS service URL (used by demos)
BERTREND_APPS_SERVICE_URL=http://localhost:8881/

# Optional: Summary service URL (summarization API)
SUMMARY_SERVICE_URL=http://localhost:8886

# Article Scoring Service URL
ARTICLE_SCORING_SERVICE_URL=http://localhost:8887

# ------------------------
# External data providers (optional)
# ------------------------
# Semantic Scholar API Key (for arXiv/S2 enrichment)
SEMANTIC_SCHOLAR_API_KEY=
# NewsCatcher API Key (news provider)
NEWSCATCHER_API_KEY=
# DBPedia Spotlight REST API URL (used by geolocalization utils)
DBPEDIA_REST_API_URL=http://localhost:2222/rest

# ------------------------
# Embedding service security
# ------------------------
# Required when running the embedding server. All workers must share this value.
# Generate a different value from BERTREND_CLIENT_SECRET with:
# openssl rand -hex 32
BERTREND_SECRET_KEY=
# Default rate limit configuration (requests per window) for embedding server
DEFAULT_RATE_LIMIT=50
DEFAULT_RATE_WINDOW=60
# Optional path to an existing, untracked client registry. When unset, the
# server creates the "bertrend" client in memory from BERTREND_CLIENT_SECRET.
CLIENT_REGISTRY_FILE=

# ------------------------
# Scheduler service (optional)
# ------------------------
# Scheduler service type: 'crontab' or 'apscheduler'. Defaults to 'crontab'. APScheduler recommended on linux
# APScheduler requires a separate service to be running, see docs/scheduler_configuration.md for details.
# APScheduler is recommended to be run on a dedicated docker container, always on (to mimic crontab behavior).
# If using APScheduler, set SCHEDULER_SERVICE_TYPE=apscheduler and specify the APScheduler service URL
# in SCHEDULER_SERVICE_URL.
SCHEDULER_SERVICE_TYPE=crontab
# Optional: schedule service URL (only used if SCHEDULER_SERVICE_TYPE=apscheduler)
SCHEDULER_SERVICE_URL=http://localhost:8882/

# ------------------------
# Email configuration (optional)
# ------------------------
NEWSLETTER_DEFAULT_RECIPIENTS=[]
# Backend can be: gmail, smtp, sendgrid (see docs/mail_configuration.md)
BERTREND_EMAIL_BACKEND=
# For gmail backend (example)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# For smtp backend (example)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# For sendgrid backend (example)
SENDGRID_API_KEY=

#--------------------
# Timeouts
#--------------------
TOPIC_INTERPRETATION_TIMEOUT=400.0
OPENAI_PARSE_TIMEOUT=180.0
RABBITMQ_JOB_TIMEOUT=900

# -------------------
# Queue configuration
# -------------------
# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Performance tuning
RABBITMQ_PREFETCH_COUNT=1  # Number of messages to prefetch per worker
RABBITMQ_MAX_RETRIES=2
RABBITMQ_RETRY_DELAY=5000

# TTL for messages per queue (ms)
RABBITMQ_REQUEST_QUEUE_TTL_MS=86400000
RABBITMQ_RESPONSE_QUEUE_TTL_MS=86400000
RABBITMQ_ERROR_QUEUE_TTL_MS=604800000
